package {
    default_applicable_licenses: ["system_see_authmgr_license"],
}

rust_library {
    name: "libsecure_storage_aidl_wrapper",
    crate_name: "secure_storage_aidl_wrapper",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "android.hardware.security.see.storage-V1-rust",
        "liblog_rust",
        "libthiserror",
        "libcfg_if",
    ],
    no_std: {
        enabled: true,
    },
}
