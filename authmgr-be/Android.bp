package {
    default_applicable_licenses: ["system_see_authmgr_license"],
}

rust_library {
    name: "libauthmgr_be",
    crate_name: "authmgr_be",
    srcs: ["src/lib.rs"],
    host_supported: true,
    vendor_available: true,
    rustlibs: [
        "libauthgraph_core",
        "libauthmgr_common",
        "libcoset",
        "libhex",
        "liblog_rust",
        "libthiserror",
    ],
}

rust_library_rlib {
    name: "libauthmgr_be_nostd",
    crate_name: "authmgr_be",
    srcs: ["src/lib.rs"],
    vendor_available: true,
    prefer_rlib: true,
    no_stdlibs: true,
    rustlibs: [
        "libauthgraph_core_nostd",
        "libauthmgr_common_nostd",
        "libcoset_nostd",
        "libhex_nostd",
        "liblog_rust_nostd",
        "libthiserror_nostd",
    ],
}

rust_library {
    name: "libauthmgr_be_test",
    crate_name: "authmgr_be_test",
    srcs: ["src/tests_utils.rs"],
    host_supported: true,
    rustlibs: [
        "libauthgraph_core",
        "libauthmgr_common",
        "libauthmgr_common_util",
        "libauthmgr_be",
        "libcoset",
        "libdice_policy_builder",
        "liblog_rust",
    ],
}

rust_test {
    name: "libauthmgr_be_unit_test",
    crate_name: "authmgr_be_unit_test",
    srcs: ["src/lib.rs"],
    host_supported: true,
    test_suites: ["general-tests"],
    rustlibs: [
        "libauthgraph_core",
        "libauthmgr_be",
        "libauthmgr_common",
        "libcoset",
        "libhex",
        "liblog_rust",
        "libthiserror",
    ],
}
